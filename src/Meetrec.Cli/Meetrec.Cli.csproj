<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>meetrec</AssemblyName>
    <RootNamespace>Meetrec.Cli</RootNamespace>
  </PropertyGroup>

  <!-- Managed code goes into one file; native libraries stay next to it: Whisper.net looks for them on disk under
       runtimes/ and does not find them when they are bundled and extracted (see docs/decisions.md). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <WhisperPlatform>$(RuntimeIdentifier.Replace('osx-', 'macos-'))</WhisperPlatform>
  </PropertyGroup>

  <Import Project="..\..\build\WhisperRuntime.props" />

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Playback of speaker clips in the names dialog (WasapiPlayer). -->
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meetrec.Core\Meetrec.Core.csproj" />
    <ProjectReference Include="..\Meetrec.Asr\Meetrec.Asr.csproj" />
    <ProjectReference Include="..\Meetrec.Diarization\Meetrec.Diarization.csproj" />
    <ProjectReference Include="..\Meetrec.Pipeline\Meetrec.Pipeline.csproj" />
    <ProjectReference Include="..\Meetrec.Capture.Mac\Meetrec.Capture.Mac.csproj" />
    <ProjectReference Include="..\Meetrec.Capture.Windows\Meetrec.Capture.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Meetrec.Tests" />
  </ItemGroup>

  <!-- Whisper.net copies native libraries for every platform as plain files; publish only the target one. -->
  <Target Name="FilterPublishedFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WhisperPlatform)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/')) and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').Contains('/$(WhisperPlatform)/'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.metal' and !$(RuntimeIdentifier.StartsWith('osx-'))" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <CaptureHelperDir>$(MSBuildThisFileDirectory)..\..\native\meetrec-capture</CaptureHelperDir>
  </PropertyGroup>

  <!-- meetrec looks for meetrec-capture next to itself, so on macOS the Swift helper is built and copied into the output. -->
  <Target Name="BuildCaptureHelper" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="swift build -c release --arch arm64 --package-path &quot;$(CaptureHelperDir)&quot;" StandardOutputImportance="low" />
    <Copy SourceFiles="$(CaptureHelperDir)/.build/release/meetrec-capture" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCaptureHelper" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX')) and $(RuntimeIdentifier.StartsWith('osx-'))">
    <Copy SourceFiles="$(CaptureHelperDir)/.build/release/meetrec-capture" DestinationFolder="$(PublishDir)" />
  </Target>

</Project>
